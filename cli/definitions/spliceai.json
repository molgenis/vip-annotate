{
  "id": "SPLICEAI",
  "description": "SpliceAI splicing effect prediction, see https://doi.org/10.1016/j.cell.2018.12.015",
  "version": "1.0.0",
  "input": {
    "type": "tsv",
    "header": true,
    "coordinate_system": "1-based",
    "columns": {
      "contig": {
        "name": "#[0]CHROM"
      },
      "start": {
        "name": "[1]POS"
      },
      "ref": {
        "name": "[2]REF"
      },
      "alt": {
        "name": "[3]ALT"
      },
      "annotations": {
        "ncbi_gene_id": {
          "name": "[4]NCBI_GENE_ID"
        },
        "ds_ag": {
          "name": "[5]DS_AG"
        },
        "ds_al": {
          "name": "[6]DS_AL"
        },
        "ds_dg": {
          "name": "[7]DS_DG"
        },
        "ds_dl": {
          "name": "[8]DS_DL"
        },
        "dp_ag": {
          "name": "[9]DP_AG"
        },
        "dp_al": {
          "name": "[10]DP_AL"
        },
        "dp_dg": {
          "name": "[11]DP_DG"
        },
        "dp_dl": {
          "name": "[12]DP_DL"
        }
      }
    }
  },
  "definition": {
    "annotation_type": "sequence_variant",
    "annotations": {
      "ncbi_gene_id": {
        "type": "integer",
        "description": "NCBI gene identifier"
      },
      "ds_ag": {
        "type": "floating_point",
        "encoding": "lossy_q16",
        "description": "Delta score (acceptor gain)"
      },
      "ds_al": {
        "type": "floating_point",
        "encoding": "lossy_q16",
        "description": "Delta score (acceptor loss)"
      },
      "ds_dg": {
        "type": "floating_point",
        "encoding": "lossy_q16",
        "description": "Delta score (donor gain)"
      },
      "ds_dl": {
        "type": "floating_point",
        "encoding": "lossy_q16",
        "description": "Delta score (donor loss)"
      },
      "dp_ag": {
        "type": "integer",
        "description": "Delta position (acceptor gain)"
      },
      "dp_al": {
        "type": "integer",
        "description": "Delta position (acceptor loss)"
      },
      "dp_dg": {
        "type": "integer",
        "description": "Delta position (donor gain)"
      },
      "dp_dl": {
        "type": "integer",
        "description": "Delta position (donor loss)"
      }
    }
  }
}

{
  "id": "REMM",
  "description": "REMM (Regulatory Mendelian Mutation) score, see https://doi.org/10.1093/gigascience/giad024",
  "version": "1.0.0",
  "input": {
    "type": "tsv",
    "header": false,
    "coordinate_system": "1-based",
    "columns": {
      "contig": {
        "index": 1
      },
      "start": {
        "index": 2
      },
      "annotations": {
        "score": {
          "index": 3
        }
      }
    }
  },
  "definition": {
    "annotation_type": "position",
    "annotations": {
      "score": {
        "type": "floating_point",
        "description": "score prediction of the potential pathogenicity of noncoding variants"
      }
    }
  }
}
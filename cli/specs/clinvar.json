{
  "id": "CLNVAR",
  "description": "ClinVar 2026-08-22, see https://www.ncbi.nlm.nih.gov/clinvar/",
  "version": "1.0.0",
  "input": {
    "type": "tsv",
    "header": true,
    "coordinate_system": "1-based",
    "columns": {
      "contig": {
        "index": 1
      },
      "start": {
        "index": 2
      },
      "ref": {
        "index": 4
      },
      "alt": {
        "index": 5
      },
      "annotations": {
        "id": {
          "index": 3
        },
        "clnsig": {
          "index": 6
        },
        "clnrevstat": {
          "index": 8
        }
      }
    }
  },
  "definition": {
    "annotation_type": "sequence_variant",
    "annotations": {
      "id": {
        "type": "integer",
        "description": "ClinVar Allele ID"
      },
      "clnsig": {
        "type": "enum_set",
        "description": "Aggregate germline classification for this single variant",
        "values": [
          {
            "value": "Uncertain_significance"
          },
          {
            "value": "Likely_benign"
          },
          {
            "value": "Other"
          },
          {
            "value": "Benign"
          },
          {
            "value": "Pathogenic"
          },
          {
            "value": "Conflicting_classifications_of_pathogenicity"
          },
          {
            "value": "Likely_pathogenic"
          }
        ]
      },
      "clnrevstat": {
        "type": "enum",
        "description": "ClinVar review status of germline classification for the Variation ID",
        "values": [
          {
            "value": "criteria_provided,_single_submitter"
          },
          {
            "value": "criteria_provided,_multiple_submitters,_no_conflicts"
          },
          {
            "value": "criteria_provided,_conflicting_classifications"
          },
          {
            "value": "no_assertion_criteria_provided"
          },
          {
            "value": "reviewed_by_expert_panel"
          },
          {
            "value": "no_classification_provided"
          },
          {
            "value": "no_classification_for_the_single_variant"
          },
          {
            "value": "no_classifications_from_unflagged_records"
          },
          {
            "value": "practice_guideline"
          }
        ]
      }
    }
  }
}

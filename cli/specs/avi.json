{
  "id": "AVI",
  "description": "AlphaGenome Variant Impact (AVI) score, see https://doi.org/10.64898/2026.09.16.26363192",
  "version": "1.0.0",
  "input": {
    "type": "tsv",
    "header": true,
    "coordinate_system": "1-based",
    "columns": {
      "contig": {
        "index": 1
      },
      "start": {
        "index": 2
      },
      "ref": {
        "index": 3
      },
      "alt": {
        "index": 4
      },
      "annotations": {
        "raw_score": {
          "index": 5
        },
        "score": {
          "index": 6
        }
      }
    }
  },
  "definition": {
    "annotation_type": "sequence_variant",
    "annotations": {
      "raw_score": {
        "type": "floating_point",
        "description": "Raw model predictions"
      },
      "score": {
        "type": "floating_point",
        "description": "Raw model predictions converted to PHRED scores (PHRED 10 indicates top 10% of predictions, 20 indicates top 1%, etc.)"
      }
    }
  }
}
{
  "id": "GNOMAD",
  "description": "gnomAD v4.1.0, see https://gnomad.broadinstitute.org/",
  "version": "1.0.0",
  "input": {
    "type": "tsv",
    "header": true,
    "coordinate_system": "1-based",
    "columns": {
      "contig": {
        "index": 1
      },
      "start": {
        "index": 2
      },
      "ref": {
        "index": 3
      },
      "alt": {
        "index": 4
      },
      "annotations": {
        "src": {
          "index": 5
        },
        "af": {
          "index": 6
        },
        "faf95": {
          "index": 7
        },
        "faf99": {
          "index": 8
        },
        "nhomalt": {
          "index": 9
        },
        "filters": {
          "index": 10
        },
        "cov": {
          "index": 11
        }
      }
    }
  },
  "definition": {
    "annotation_type": "sequence_variant",
    "annotations": {
      "src": {
        "type": "enum",
        "description": "Source",
        "values": [
          {
            "value": "G",
            "description": "Genomes"
          },
          {
            "value": "E",
            "description": "Exomes"
          },
          {
            "value": "T",
            "description": "Genomes+Exomes"
          }
        ]
      },
      "af": {
        "type": "floating_point",
        "description": "Alternate allele frequency"
      },
      "faf95": {
        "type": "floating_point",
        "description": "Filtering allele frequency (using Poisson 95% CI)"
      },
      "faf99": {
        "type": "floating_point",
        "description": "Filtering allele frequency (using Poisson 99% CI)"
      },
      "nhomalt": {
        "type": "integer",
        "description": "Count of homozygous individuals"
      },
      "filters": {
        "type": "enum_set",
        "description": "Failed variant filters",
        "values": [
          {
            "value": "AC0",
            "description": "Allele count is zero due to removal of low quality genotypes"
          },
          {
            "value": "AS_VQSR",
            "description": "Failed allele-specific VQSR filter"
          },
          {
            "value": "InbreedingCoeff",
            "description": "Has an inbreeding coefficient < -0.3"
          }
        ]
      },
      "cov": {
        "type": "floating_point",
        "description": "Percentage of individuals with coverage at this variant"
      }
    }
  }
}
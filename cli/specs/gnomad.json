{
  "id": "GNOMAD",
  "description": "gnomAD v4.1.0, see https://gnomad.broadinstitute.org/",
  "version": "1.0.0",
  "input": {
    "type": "tsv",
    "coordinate_system": "1-based",
    "contig": 0,
    "start": 1,
    "ref": 2,
    "alt": 3,
    "annotations": {
      "src": 4,
      "af": 5,
      "faf95": 6,
      "faf99": 7,
      "nhomalt": 8,
      "filters": 9,
      "cov": 10
    }
  },
  "schema": {
    "annotation_type": "sequence_variant",
    "annotation_datasets": {
      "src": {
        "type": "enum",
        "description": "Source: E=Exomes, G=Genomes, T=Joint",
        "values": [
          "G",
          "E",
          "T"
        ]
      },
      "af": {
        "type": "floating_point",
        "description": "Alternate allele frequency"
      },
      "faf95": {
        "type": "floating_point",
        "description": "Filtering allele frequency (using Poisson 95% CI)"
      },
      "faf99": {
        "type": "floating_point",
        "description": "Filtering allele frequency (using Poisson 95% CI)"
      },
      "nhomalt": {
        "type": "integer",
        "description": "Count of homozygous individuals"
      },
      "filters": {
        "type": "enum_set",
        "description": "Failed variant filters",
        "values": [
          "AC0",
          "AS_VQSR",
          "InbreedingCoeff"
        ]
      },
      "cov": {
        "description": "Percentage of individuals with coverage at this variant",
        "type": "floating_point"
      }
    },
    "annotation_selector": "max_value"
  }
}
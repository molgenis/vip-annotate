{
  "id": "SPLICEAI",
  "description": "SpliceAI splicing effect prediction, see https://doi.org/10.1016/j.cell.2018.12.015",
  "version": "1.0.0",
  "input": {
    "type": "tsv",
    "coordinate_system": "1-based",
    "contig": 0,
    "start": 1,
    "ref": 2,
    "alt": 3,
    "annotation_columns": {
      "ncbi_gene_id": 4,
      "ds_ag": 5,
      "ds_al": 6,
      "ds_dg": 7,
      "ds_dl": 8,
      "dp_ag": 9,
      "dp_al": 10,
      "dp_dg": 11,
      "dp_dl": 12
    }
  },
  "schema": {
    "annotation_type": "sequence_variant",
    "annotations": {
      "ncbi_gene_id": {
        "type": "integer",
        "description": "NCBI gene identifier"
      },
      "ds_ag": {
        "type": "floating_point",
        "description": "Delta score (acceptor gain)"
      },
      "ds_al": {
        "type": "floating_point",
        "description": "Delta score (acceptor loss)"
      },
      "ds_dg": {
        "type": "floating_point",
        "description": "Delta score (donor gain)"
      },
      "ds_dl": {
        "type": "floating_point",
        "description": "Delta score (donor loss)"
      },
      "dp_ag": {
        "type": "integer",
        "description": "Delta position (acceptor gain)"
      },
      "dp_al": {
        "type": "integer",
        "description": "Delta position (acceptor loss)"
      },
      "dp_dg": {
        "type": "integer",
        "description": "Delta position (donor gain)"
      },
      "dp_dl": {
        "type": "integer",
        "description": "Delta position (donor loss)"
      }
    },
    "annotation_selector": "max_value"
  }
}

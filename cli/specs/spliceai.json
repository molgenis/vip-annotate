{
  "id": "spliceai",
  "version": "1.0.0",
  "input": {
    "type": "tsv",
    "coordinate_system": "1-based",
    "contig": 0,
    "start": 1,
    "ref": 2,
    "alt": 3,
    "annotations": {
      "ncbi_gene_id": 4,
      "ds_ag": 5,
      "ds_al": 6,
      "ds_dg": 7,
      "ds_dl": 8,
      "dp_ag": 9,
      "dp_al": 10,
      "dp_dg": 11,
      "dp_dl": 12
    }
  },
  "schema": {
    "annotation_type": "sequence_variant",
    "annotation_datasets": {
      "ncbi_gene_id": {
        "type": "integer"
      },
      "ds_ag": {
        "type": "floating_point"
      },
      "ds_al": {
        "type": "floating_point"
      },
      "ds_dg": {
        "type": "floating_point"
      },
      "ds_dl": {
        "type": "floating_point"
      },
      "dp_ag": {
        "type": "integer"
      },
      "dp_al": {
        "type": "integer"
      },
      "dp_dg": {
        "type": "integer"
      },
      "dp_dl": {
        "type": "integer"
      }
    },
    "annotation_selector": "max_value"
  },
  "output": {
    "type": "vcf",
    "infoId": "SpliceAI",
    "infoNumber": "A",
    "infoType": "String",
    "infoDescription": "SpliceAI v1.3 annotation formatted as 'NCBI_GENE_ID|DS_AG|DS_AL|DS_DG|DS_DL|DP_AG|DP_AL|DP_DG|DP_DL'; NCBI_GENE_ID=NCBI gene identifier, DS_AG=delta score acceptor gain, DS_AL=delta score acceptor loss, DS_DG=delta score donor gain, DP_DL=delta score donor loss, DP_AG=delta position acceptor gain, DP_AL=delta position acceptor loss, DP_DG=delta position donor gain, DP_DL=delta position donor loss",
    "infoVersion": "1.0.0"
  }
}

{
  "id": "PHYLOP",
  "description": "phyloP conservation scores, see http://compgen.bscb.cornell.edu/phast",
  "version": "1.0.0",
  "input": {
    "type": "bed",
    "annotations": {
      "score": "name"
    }
  },
  "schema": {
    "annotation_type": "position",
    "annotation_datasets": {
      "score": {
        "type": "floating_point",
        "description": "evolutionary conservation measure, with positive scores indicating conservation and negative scores indicating accelerated evolution"
      }
    },
    "annotation_selector": "max_value"
  }
}
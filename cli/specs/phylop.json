{
  "id": "PHYLOP",
  "description": "phyloP conservation scores, see http://compgen.bscb.cornell.edu/phast",
  "version": "1.0.0",
  "input": {
    "type": "bed",
    "annotations": {
      "score": "score"
    }
  },
  "definition": {
    "annotation_type": "position",
    "annotations": {
      "score": {
        "type": "floating_point",
        "encoding": "lossy_q16",
        "description": "positive scores indicating conservation and negative scores indicating accelerated evolution"
      }
    }
  }
}
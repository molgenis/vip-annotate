{
  "id": "NCER",
  "description": "ncER non-coding essential regulation, see https://doi.org/10.1038/s41467-019-13212-3",
  "version": "1.0.0",
  "input": {
    "type": "bed",
    "annotations": {
      "score": "name"
    }
  },
  "schema": {
    "annotation_type": "position",
    "annotations": {
      "score": {
        "type": "floating_point",
        "description": " non-coding essential regulation score ranging from 0 (non-essential) to 1 (putative essential)"
      }
    },
    "annotation_selector": "max_value"
  },
  "output": {
    "type": "vcf",
    "infoId": "ncER",
    "infoNumber": "A",
    "infoType": "Float",
    "infoDescription": "ncER score",
    "infoVersion": "1.0.0"
  }
}
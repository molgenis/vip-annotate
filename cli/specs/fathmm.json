{
  "id": "FATHMM_MKL",
  "description": "FATHMM-MKL functional consequence prediction for coding/non-coding SNVs, see https://doi.org/10.1093/bioinformatics/btv009",
  "version": "1.0.0",
  "input": {
    "type": "tsv",
    "header": false,
    "coordinate_system": "1-based",
    "columns": {
      "contig": {
        "index": 1
      },
      "start": {
        "index": 2
      },
      "ref": {
        "index": 3
      },
      "alt": {
        "index": 4
      },
      "annotations": {
        "score": {
          "index": 5
        }
      }
    }
  },
  "definition": {
    "annotation_type": "sequence_variant",
    "annotations": {
      "score": {
        "type": "floating_point",
        "encoding": "lossy_q8",
        "description": "p-value: above 0.5 predicts deleterious; below 0.5 predicts neutral/benign."
      }
    }
  }
}
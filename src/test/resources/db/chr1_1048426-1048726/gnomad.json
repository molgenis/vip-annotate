{
  "id": "gnomad",
  "version": "1.0.0",
  "input": {
    "type": "tsv",
    "file": "gnomad.total.v4.1.sites.stripped-v3.preprocessed.tsv.gz",
    "coordinate_system": "1-based",
    "contig": 0,
    "start": 1,
    "ref": 2,
    "alt": 3,
    "annotations": [
      4,
      5,
      6,
      7,
      8,
      9,
      10
    ]
  },
  "schema": {
    "annotation_type": "sequence_variant",
    "supported_variant_types": [
      "snv",
      "mnv",
      "indel",
      "insertion",
      "deletion"
    ],
    "annotation_datasets": [
      {
        "id": "src",
        "annotation_value": {
          "storage_type": {
            "scalar_type": "u8"
          },
          "logical_type": {
            "type": "enum",
            "values": [
              "G",
              "E",
              "T"
            ],
            "nullable": false
          },
          "encoding": {
            "type": "enum"
          }
        }
      },
      {
        "id": "af",
        "annotation_value": {
          "storage_type": {
            "scalar_type": "u16"
          },
          "logical_type": {
            "type": "scalar",
            "scalar_type": "f64"
          },
          "encoding": {
            "type": "quantized",
            "range": {
              "min": 0,
              "max": 1
            },
            "levels": {
              "min": 0,
              "max": 65535
            }
          }
        }
      },
      {
        "id": "faf95",
        "annotation_value": {
          "storage_type": {
            "scalar_type": "u16"
          },
          "logical_type": {
            "type": "scalar",
            "scalar_type": "f64",
            "nullable": false
          },
          "encoding": {
            "type": "quantized",
            "range": {
              "min": 0,
              "max": 1
            },
            "levels": {
              "min": 0,
              "max": 65535
            }
          }
        }
      },
      {
        "id": "faf99",
        "annotation_value": {
          "storage_type": {
            "scalar_type": "u16"
          },
          "logical_type": {
            "type": "scalar",
            "scalar_type": "f64",
            "nullable": false
          },
          "encoding": {
            "type": "quantized",
            "range": {
              "min": 0,
              "max": 1
            },
            "levels": {
              "min": 0,
              "max": 65535
            }
          }
        }
      },
      {
        "id": "nhomalt",
        "annotation_value": {
          "storage_type": {
            "scalar_type": "i32"
          },
          "logical_type": {
            "type": "scalar",
            "scalar_type": "i32",
            "nullable": false
          }
        }
      },
      {
        "id": "filters",
        "annotation_value": {
          "storage_type": {
            "scalar_type": "u8"
          },
          "logical_type": {
            "type": "enum_set",
            "values": [
              "AC0",
              "AS_VQSR",
              "InbreedingCoeff"
            ]
          },
          "encoding": {
            "type": "enum"
          }
        }
      },
      {
        "id": "COV",
        "annotation_value": {
          "storage_type": {
            "scalar_type": "u16"
          },
          "logical_type": {
            "type": "scalar",
            "scalar_type": "f64",
            "nullable": false
          },
          "encoding": {
            "type": "quantized",
            "range": {
              "min": 0,
              "max": 1
            },
            "levels": {
              "min": 0,
              "max": 65535
            }
          }
        }
      }
    ],
    "annotation_selector": "max_value"
  },
  "output": {
    "type": "vcf",
    "infoId": "gnomAD",
    "infoNumber": "A",
    "infoType": "String",
    "infoDescription": "gnomAD v4.1.0 annotation formatted as 'SRC|AF|FAF95|FAF99|HN|QC|COV'; SRC=source (E=exomes, G=genomes, T=total), AF=allele frequency, FAF95=filtering allele frequency (95% confidence), FAF99=filtering allele frequency (99% confidence), HN=number of homozygotes, QC=quality control filters that failed, COV=coverage (percent of individuals in gnomAD source)",
    "infoVersion": "1.0.0"
  }
}